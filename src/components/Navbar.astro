---
import { ui } from '@/i18n/ui'
import { getPageInfo } from '@/utils/page'

const { currentLang, isHome, isPost, isTag, isAbout, isGallery, getLocalizedPath } = getPageInfo(Astro.url.pathname)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}

const isPostActive = isHome || isPost
const isTagActive = isTag
const isAboutActive = isAbout

function getNavItemClass(isActive: boolean) {
  return isActive
    ? 'highlight-static c-primary font-bold after:bottom-0.7em'
    : 'highlight-hover transition-[colors,font-weight] after:bottom-0.7em hover:(c-primary font-bold)'
}

const navItems = [
  {
    href: '/',
    active: isPostActive,
    label: currentUI.posts,
    className: getNavItemClass(isPostActive),
  },
  {
    href: '/tags/',
    active: isTagActive,
    label: currentUI.tags,
    className: getNavItemClass(isTagActive),
  },
  {
    href: '/gallery/',
    active: isGallery,
    label: currentUI.gallery,
    className: getNavItemClass(isGallery),
  },
  {
    href: '/about/',
    active: isAboutActive,
    label: currentUI.about,
    className: getNavItemClass(isAboutActive),
  },
]
---

<nav
  aria-label={currentLang === 'zh' ? '网站导航' : 'Site navigation'}
  class:list={[
    'site-nav mb-8 text-3.6 font-semibold leading-2.45em font-navbar',
    'lg:(uno-desktop-column text-4 bottom-[min(9.04rem+3.85vw,12.5rem)]) cjk:tracking-wide',
  ]}
>
  <ul>
    {navItems.map(item => (
      <li>
        <a
          href={getLocalizedPath(item.href)}
          class={item.className}
          aria-current={item.active ? 'page' : undefined}
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  @media (max-width: 1023px) {
    .site-nav ul { display: flex; flex-wrap: wrap; gap: .3rem 1.6rem; }
    .site-nav a { display: inline-flex; align-items: center; min-height: 44px; }
  }
</style>
