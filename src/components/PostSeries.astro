---
import type { CollectionEntry } from 'astro:content'
import type { Language } from '@/i18n/config'
import { getCollection } from 'astro:content'
import { getPostPath, getTagPath } from '@/i18n/path'
import { postSeries } from '@/utils/post-series'

interface Props { post: CollectionEntry<'posts'>, lang: Language }
const { post, lang } = Astro.props
const { tag, tagPath, entries } = postSeries(post, await getCollection('posts'), lang)
const years = [...new Set(entries.map(entry => new Date(entry.data.published).getUTCFullYear()))]
---
{tag && (
<nav class="post-series" aria-label={lang === 'zh' ? '同标签文章' : 'Articles in this tag'}>
  <div class="series-heading"><a href={getTagPath(tagPath, lang)}>{tag}</a><span>{entries.length}</span></div>
  <div class="series-list">
    {years.map(year => <section><h2>{year}</h2><ul>{entries.filter(entry => new Date(entry.data.published).getUTCFullYear() === year).map(entry => <li><a href={getPostPath(entry.data.abbrlink || entry.id, lang)} aria-current={entry.id === post.id ? 'page' : undefined}>{entry.data.title}</a></li>)}</ul></section>)}
  </div>
</nav>
)}
<style>
  .post-series { font: 12px/1.7 system-ui; }
  .series-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 20px; }
  .series-heading a { font-weight: 600; }
  .series-heading span { opacity: .35; font-size: 10px; font-variant-numeric: tabular-nums; }
  .series-list { max-height: calc(100dvh - 130px); overflow-y: auto; scrollbar-width: thin; }
  h2 { font: 11px/1.5 system-ui; opacity: .35; margin: 24px 0 8px; }
  section:first-child h2 { margin-top: 0; }
  ul { list-style: none; padding: 0; margin: 0; }
  li a { display: block; padding: 7px 0; opacity: .6; transition: opacity .15s; }
  li a:hover, li a[aria-current] { opacity: 1; }
  li a[aria-current] { font-weight: 600; }
  @media (max-width: 1279px) { .series-list { max-height: 320px; } .post-series { border-top: 1px solid; --at-apply: 'border-secondary/10'; padding-top: 24px; } }
</style>
