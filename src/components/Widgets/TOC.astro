---
import type { MarkdownHeading } from 'astro'
import TocIcon from '@/assets/icons/toc-icon.svg'
import { ui } from '@/i18n/ui'
import { getPageInfo } from '@/utils/page'

interface Props {
  headings: MarkdownHeading[]
}

const { currentLang } = getPageInfo(Astro.url.pathname)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}

const { headings = [] } = Astro.props
const filteredHeadings = headings.filter(heading => heading.depth >= 2 && heading.depth <= 4)
---

{filteredHeadings.length > 0 && (
  // TOC Container
  <div
    id="toc-container"
    class="mb-6 uno-round-border bg-secondary/5 2xl:(fixed left-0 top-44.5 max-w-[min(calc(50vw-38rem),13rem)] border-none bg-secondary/0)"
  >
    {/* Hidden Checkbox */}
    <input
      type="checkbox"
      id="toc-toggle"
      hidden
    />
    {/* TOC Toggle */}
    <div class="relative h-12 w-full">
      <label
        for="toc-toggle"
        class="absolute inset-0 flex cursor-pointer items-center 2xl:(static flex c-secondary/60 transition-colors ease-out hover:c-primary)"
      >
        {/* Title on Mobile */}
        <span id="toc-mobile-text">
          {currentUI.toc}
        </span>

        {/* Icon on Desktop */}
        <TocIcon
          id="toc-desktop-icon"
          aria-hidden="true"
          class="ml-4 hidden aspect-square w-4.2 2xl:(mt-4 block origin-center active:scale-90!)"
          fill="currentColor"
        />
      </label>
    </div>

    {/* Expandable Content Wrapper with Accordion Animation */}
    <div id="toc-accordion-wrapper">
      <nav
        id="toc-accordion-content"
        aria-label="Table of Contents"
      >
        {/* TOC List */}
        <ul id="toc-links-list">
          {filteredHeadings.map(heading => (
            <li
              class:list={{
                'ml-0': heading.depth === 2,
                'ml-4': heading.depth === 3,
                'ml-8': heading.depth === 4,
              }}
            >
              <a
                href={`#${heading.slug}`}
                class:list={[
                  { 'no-heti toc-links-h2': heading.depth === 2 },
                  { 'no-heti toc-links-h3': heading.depth === 3 },
                  { 'no-heti toc-links-h4': heading.depth === 4 },
                ]}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <button type="button" class="toc-floating-button" data-toc-open aria-label={currentUI.toc || '目录'} aria-expanded="false" aria-controls="toc-container"><TocIcon width="18" height="18" aria-hidden="true" fill="currentColor" /></button>
  </div>
)}

<script>
let dispose: (() => void) | undefined
function setupTOC() {
  dispose?.()
  const container = document.getElementById('toc-container')
  const button = document.querySelector<HTMLButtonElement>('[data-toc-open]')
  const checkbox = document.querySelector<HTMLInputElement>('#toc-toggle')
  const nav = document.querySelector<HTMLElement>('#toc-accordion-content')
  if (!container || !button || !checkbox || !nav)
    return
  // A transformed article becomes the containing block for fixed elements.
  // Keep the floating controls outside it, restoring the markup before swaps.
  const home = document.createComment('toc-home')
  container.before(home)
  document.body.append(button)
  const signal = new AbortController()
  const timers = new Set<number>()
  const links = [...container.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')]
  const headings = links.map(link => document.getElementById(decodeURIComponent(link.hash.slice(1))))
  let current = -1
  let frame = 0
  let previousExpanded = checkbox.checked
  const close = () => {
    if (container.classList.contains('toc-popover')) {
      home.after(container)
      checkbox.checked = previousExpanded
    }
    container.classList.remove('toc-popover')
    button.setAttribute('aria-expanded', 'false')
  }
  const update = () => {
    frame = 0
    let next = 0
    headings.forEach((heading, index) => {
      if (heading && heading.getBoundingClientRect().top <= 120)
        next = index
    })
    if (next === current)
      return
    current = next
    links.forEach((link, index) => index === current ? link.setAttribute('aria-current', 'location') : link.removeAttribute('aria-current'))
    if (window.innerWidth >= 1280) {
      const top = links[current].offsetTop - nav.offsetTop
      if (top < nav.scrollTop || top > nav.scrollTop + nav.clientHeight - 32)
        nav.scrollTo({ top: top - nav.clientHeight / 2, behavior: document.documentElement.classList.contains('reduce-motion') ? 'instant' : 'smooth' })
    }
  }
  document.addEventListener('scroll', () => {
    frame ||= requestAnimationFrame(update)
  }, { passive: true, signal: signal.signal })
  button.addEventListener('click', () => {
    const open = !container.classList.contains('toc-popover')
    if (open) {
      previousExpanded = checkbox.checked
      document.body.append(container)
      container.classList.add('toc-popover')
      checkbox.checked = true
      button.setAttribute('aria-expanded', 'true')
      links[current]?.focus({ preventScroll: true })
    }
    else {
      close()
    }
  }, { signal: signal.signal })
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement
    const link = target.closest<HTMLAnchorElement>('#toc-links-list a, .heading-anchor-link')
    if (link) {
      const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)))
      if (heading) {
        heading.classList.add('heading-flash')
        const timer = window.setTimeout(() => {
          heading.classList.remove('heading-flash')
          timers.delete(timer)
        }, 1800)
        timers.add(timer)
      }
      close()
    }
    else if (!target.closest('#toc-container, [data-toc-open]')) {
      close()
    }
  }, { signal: signal.signal })
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && container.classList.contains('toc-popover')) {
      close()
      button.focus({ preventScroll: true })
    }
  }, { signal: signal.signal })
  update()
  dispose = () => {
    signal.abort()
    cancelAnimationFrame(frame)
    timers.forEach(clearTimeout)
    close()
    container.append(button)
    home.remove()
  }
}
document.addEventListener('astro:page-load', setupTOC)
document.addEventListener('astro:before-swap', () => {
  dispose?.()
  dispose = undefined
})
</script>
<style is:global>
  #toc-links-list a[aria-current="location"] { font-weight: 600; --at-apply: 'c-primary'; }
  .toc-floating-button { position: fixed; bottom: max(20px,env(safe-area-inset-bottom)); left: 20px; z-index: 45; width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; border: 1px solid; --at-apply: 'border-secondary/15 bg-background c-secondary/75'; box-shadow: 0 3px 20px #0000000d; }
  #toc-container.toc-popover { position: fixed; z-index: 46; inset: auto auto 76px 20px; width: min(440px,calc(100vw - 40px)); margin: 0; padding-bottom: 12px; --at-apply: 'bg-background'; box-shadow: 0 8px 40px #00000018; }
  #toc-container.toc-popover #toc-accordion-content { max-height: 55vh; overflow: auto; }
  .heading-flash { animation: heading-flash 1.8s ease-out; border-radius: 4px; }
  @keyframes heading-flash { from { background: #91ac7840; } to { background: transparent; } }
  @media (min-width: 1280px) { .toc-floating-button { display: none; } }
  @media (prefers-reduced-motion: reduce) { .heading-flash { animation: none; outline: 1px solid #91ac7870; } }
</style>
