<script>
let overlay: HTMLDivElement | null = null
let zoomedImg: HTMLImageElement | null = null
let originalImg: HTMLImageElement | null = null
let previousFocus: HTMLElement | null = null
let previousOverflow = ''
let closingTimer: number | undefined

function cleanupZoom() {
  window.clearTimeout(closingTimer)
  closingTimer = undefined
  if (zoomedImg)
    document.body.style.overflow = previousOverflow
  zoomedImg?.remove()
  overlay?.remove()
  overlay = null
  zoomedImg = null
  originalImg = null
  previousFocus = null
}
function setupOverlay() {
  cleanupZoom()
  const zh = document.documentElement.lang.startsWith('zh')
  overlay = document.createElement('div')
  overlay.className = 'zoom-overlay'
  overlay.setAttribute('role', 'dialog')
  overlay.setAttribute('aria-modal', 'true')
  overlay.setAttribute('aria-label', zh ? '照片查看器' : 'Image viewer')
  overlay.tabIndex = -1
  const close = document.createElement('button')
  close.type = 'button'
  close.className = 'zoom-close'
  close.setAttribute('aria-label', zh ? '关闭照片' : 'Close image')
  close.textContent = '×'
  overlay.append(close)
  document.body.append(overlay)
  document.querySelectorAll<HTMLImageElement>('#post-content img').forEach((img) => {
    if (img.closest('a, [data-gallery]'))
      return
    img.tabIndex = 0
    img.setAttribute('role', 'button')
    img.setAttribute('aria-haspopup', 'dialog')
    img.setAttribute('aria-label', `${img.alt || (zh ? '照片' : 'Image')} · ${zh ? '点击放大' : 'Enlarge image'}`)
  })
}
function zoomIn(img: HTMLImageElement) {
  if (!overlay || !img.complete || !img.naturalWidth || img.width < 100 || img.height < 100)
    return
  previousOverflow = document.body.style.overflow
  previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null
  document.body.style.overflow = 'hidden'
  const rect = img.getBoundingClientRect()
  originalImg = img
  zoomedImg = img.cloneNode() as HTMLImageElement
  zoomedImg.className = 'zoom-img'
  for (const attribute of ['id', 'loading', 'role', 'tabindex', 'aria-label', 'aria-haspopup'])
    zoomedImg.removeAttribute(attribute)
  zoomedImg.style.top = `${rect.top}px`
  zoomedImg.style.left = `${rect.left}px`
  zoomedImg.style.width = `${rect.width}px`
  zoomedImg.style.height = `${rect.height}px`
  overlay.append(zoomedImg)
  overlay.style.display = 'block'
  overlay.querySelector<HTMLButtonElement>('button')?.focus()
  const scaleFactor = window.innerWidth < 768 ? 0.94 : 0.8
  const scale = Math.min(window.innerWidth * scaleFactor / rect.width, window.innerHeight * scaleFactor / rect.height)
  const translateX = (-rect.left + (window.innerWidth - rect.width) / 2) / scale
  const translateY = (-rect.top + (window.innerHeight - rect.height) / 2) / scale
  requestAnimationFrame(() => {
    if (overlay)
      overlay.style.opacity = '1'
    if (zoomedImg)
      zoomedImg.style.transform = `scale(${scale}) translate3d(${translateX}px, ${translateY}px, 0)`
  })
}
function zoomOut() {
  if (!overlay || !zoomedImg)
    return
  window.clearTimeout(closingTimer)
  const closingImage = zoomedImg
  closingImage.style.transform = ''
  overlay.style.opacity = '0'
  document.body.style.overflow = previousOverflow
  const finish = () => {
    if (zoomedImg !== closingImage)
      return
    window.clearTimeout(closingTimer)
    closingImage.remove()
    zoomedImg = null
    if (overlay)
      overlay.style.display = 'none'
    const focus = previousFocus?.isConnected && previousFocus !== document.body ? previousFocus : originalImg
    focus?.focus({ preventScroll: true })
    originalImg = null
    previousFocus = null
  }
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || document.documentElement.classList.contains('reduce-motion')) {
    finish()
  }
  else {
    closingImage.addEventListener('transitionend', finish, { once: true })
    closingTimer = window.setTimeout(finish, 350)
  }
}
function handleClick(event: MouseEvent) {
  if (zoomedImg) {
    zoomOut()
    return
  }
  const target = event.target
  if (!(target instanceof HTMLImageElement) || target.closest('a, [data-gallery]'))
    return
  event.preventDefault()
  zoomIn(target)
}
document.addEventListener('keydown', (event) => {
  if (zoomedImg) {
    if (event.key === 'Escape') {
      event.preventDefault()
      zoomOut()
    }
    else if (event.key === 'Tab') {
      event.preventDefault()
      overlay?.querySelector<HTMLButtonElement>('button')?.focus()
    }
    return
  }
  if ((event.key === 'Enter' || event.key === ' ') && event.target instanceof HTMLImageElement && event.target.getAttribute('role') === 'button') {
    event.preventDefault()
    zoomIn(event.target)
  }
})
document.addEventListener('astro:page-load', setupOverlay)
document.addEventListener('astro:before-swap', cleanupZoom)
document.addEventListener('click', handleClick)
window.addEventListener('resize', zoomOut)
setupOverlay()
</script>

<style is:global>
  .zoom-close { position: fixed; right: 1rem; top: 1rem; z-index: 1001; width: 44px; height: 44px; font-size: 2rem; line-height: 1; color: inherit; cursor: pointer; }
  @media (prefers-reduced-motion: reduce) { .zoom-img, .zoom-overlay { transition: none; } }
  html.reduce-motion .zoom-img, html.reduce-motion .zoom-overlay { transition: none; }
</style>
