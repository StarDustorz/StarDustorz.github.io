---
import type { Language } from '@/i18n/config'
import PhotoViewer from '@/components/Gallery/PhotoViewer.astro'
import { getLangFromLocale } from '@/i18n/lang'
import Head from '@/layouts/Head.astro'
import '@/styles/font.css'
import '@/styles/global.css'

interface Props { title: string, description?: string, supportedLangs?: Language[] }
const { title, description, supportedLangs } = Astro.props
---
<html lang={getLangFromLocale(Astro.currentLocale)} class="gallery-document font-sans">
  <Head postTitle={title} postDescription={description} {supportedLangs} />
  <body><a class="skip-link" href="#main-content">跳到相册</a><main id="main-content" tabindex="-1"><slot /></main><PhotoViewer /></body>
</html>
<style is:global>
  html.gallery-document { scrollbar-gutter: auto; }
  .gallery-document, .gallery-document body { margin: 0; padding: 0; width: 100%; min-height: 100dvh; }
  .gallery-document main { width: 100%; }
  .gallery-document button, .gallery-document select { font: inherit; }
  .gallery-document button { cursor: pointer; }
</style>
