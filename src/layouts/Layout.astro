---
import type { Language } from '@/i18n/config'
import Footer from '@/components/Footer.astro'
import PhotoViewer from '@/components/Gallery/PhotoViewer.astro'
import Header from '@/components/Header.astro'
import Navbar from '@/components/Navbar.astro'
import SiteControls from '@/components/SiteControls.astro'
import CodeCopyButton from '@/components/Widgets/CodeCopyButton.astro'
import GithubCard from '@/components/Widgets/GithubCard.astro'
import MediaEmbed from '@/components/Widgets/MediaEmbed.astro'
import SoundEffect from '@/components/Widgets/SoundEffect.astro'
import { themeConfig } from '@/config'
import { getLangFromLocale } from '@/i18n/lang'
import Head from '@/layouts/Head.astro'
import { getPageInfo } from '@/utils/page'
import '@/styles/font.css'
import '@/styles/global.css'
import '@/styles/transition.css'

interface Props {
  postTitle?: string
  postDescription?: string
  postSlug?: string
  supportedLangs?: Language[]
  katex?: boolean
}

const { postTitle, postDescription, postSlug, supportedLangs = [], katex = false } = Astro.props
const { isPost } = getPageInfo(Astro.url.pathname)
const fontStyle = themeConfig.global.fontStyle === 'serif' ? 'font-serif' : 'font-sans'
const MarginBottom = isPost && themeConfig.comment.enabled
  ? 'mb-10' // Post page with comment
  : 'mb-12' // Other pages without comment
---

<html
  lang={getLangFromLocale(Astro.currentLocale)}
  class:list={[
    fontStyle,
    isPost ? 'scroll-smooth' : '',
  ]}
>
  <Head {postTitle} {postDescription} {postSlug} {supportedLangs} katex={themeConfig.global.katex && katex} />
  <body class:list={{ 'post-page': isPost }}>
    <a class="skip-link" href="#main-content">{getLangFromLocale(Astro.currentLocale) === 'zh' ? '跳到正文' : 'Skip to content'}</a>
    <div
      class:list={['layout-shell mx-auto max-w-205.848 min-h-vh w-full min-h-dvh', { 'article-shell': isPost }]}
    >
      <Header />
      {isPost ? <div class="article-nav-space" aria-hidden="true"></div> : <Navbar />}
      <div class:list={{ 'article-columns': isPost }}>
        {isPost && <aside class="article-toc"><slot name="toc" /></aside>}
        <main id="main-content" tabindex="-1" class={MarginBottom}><slot /></main>
        {isPost && <aside class="article-series"><slot name="series" /></aside>}
      </div>
      <Footer />
    </div>
    {!isPost && <SiteControls {supportedLangs} />}
    <SoundEffect />
    {isPost && <CodeCopyButton />}
    {isPost && <GithubCard />}
    {isPost && <MediaEmbed />}
    {isPost && <PhotoViewer />}
  </body>
</html>

<style is:global>
  .layout-shell { padding: 2.5rem min(7.25vw, 3.731rem); }
  @media (min-width: 1024px) {
    .layout-shell:not(.article-shell) { max-width: min(calc(75vw - 16rem),44rem); margin: 5rem max(5.75rem,calc(50vw - 34.25rem)); min-height: 100%; padding: 0; }
  }
  .layout-shell main { min-width: 0; overflow-wrap: anywhere; }
  .post-page .article-shell { max-width: 1320px; margin: 0 auto; padding: 28px 32px 48px; }
  .post-page .article-shell > header { position: static; width: auto; margin: 0; }
  .post-page .article-shell > header h2 { margin: 0; font-size: 24px; }
  .post-page .article-shell > header > div { display: none; }
  .post-page .article-nav-space { height: 34.3px; margin: -36px 0 68px; }
  .post-page .article-shell > footer { position: static; width: auto; margin: 64px auto 0; max-width: 700px; opacity: .65; font-size: 12px; line-height: 1.6; }
  .post-page main { min-width: 0; max-width: 700px; margin-inline: auto; width: 100%; }
  .article-toc { display: none; }
  .article-series { max-width: 700px; margin: 48px auto 0; }
  @media (min-width: 1280px) {
    .article-columns { display: grid; grid-template-columns: minmax(160px,1fr) minmax(0,700px) minmax(180px,1fr); gap: 36px; align-items: start; }
    .article-toc { display: block; position: sticky; top: 40px; }
    .article-series { position: sticky; top: 40px; margin: 0; width: 100%; }
    .post-page #toc-container { position: static; max-width: none; border: 0; background: transparent; margin: 0; animation: none; opacity: 1; transform: none; }
    .post-page #toc-container label { position: static; cursor: default; }
    .post-page #toc-mobile-text { display: block; margin: 0; font: 12px/1.6 system-ui; opacity: .5; }
    .post-page #toc-desktop-icon { display: none; }
    .post-page #toc-accordion-wrapper { display: block; }
    .post-page #toc-accordion-content { max-height: calc(100dvh - 130px); overflow-y: auto; padding: 0 12px 0 0; }
    .post-page #toc-links-list { margin: 0; }
    .post-page #toc-links-list a { display: block; font-size: 12px; line-height: 1.7; padding-block: 5px; opacity: .65; }
    .post-page #toc-links-list a[aria-current] { opacity: 1; }
    .post-page #back-button { display: none; }
  }
  @media (max-width: 600px) {
    .layout-shell:not(.article-shell) { padding: 2.5rem 22px; }
    .post-page .article-shell { padding: 24px 22px 40px; }
    .post-page .article-shell > header h2 { font-size: 21px; }
    .post-page .article-nav-space { height: 44px; margin: 16px 0 40px; }
  }
</style>
